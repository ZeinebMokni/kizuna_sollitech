# ---------------------------------------------------------------
# QATRA environment configuration. Copy to .env and adjust.
# Never commit .env. Never put secrets in frontend variables.
# ---------------------------------------------------------------

# --- Database (docker compose maps Postgres to host port 5433) ---
POSTGRES_USER=qatra
POSTGRES_PASSWORD=qatra_dev_password
POSTGRES_DB=qatra
QATRA_DATABASE_URL=postgresql+psycopg://qatra:qatra_dev_password@localhost:5433/qatra
QATRA_TEST_DATABASE_URL=postgresql+psycopg://qatra:qatra_dev_password@localhost:5433/qatra_test

# --- Backend ---
QATRA_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QATRA_JWT_SECRET=change-me-generate-a-long-random-secret-for-dev-only
QATRA_ACCESS_TOKEN_MINUTES=15
QATRA_REFRESH_TOKEN_DAYS=14
# true in production (HTTPS only)
QATRA_COOKIE_SECURE=false
QATRA_CORS_ORIGINS=["http://localhost:3000"]
QATRA_LOG_LEVEL=INFO

# --- Seed (development only) ---
# Password for all demo accounts created by the seed script.
QATRA_SEED_DEMO_PASSWORD=Qatra-Demo-2026!

# --- Frontend (server-side only; not exposed to the browser) ---
# Next.js server-side rewrites.
ENGINE_API_URL=http://localhost:8100
PLATFORM_API_URL=http://localhost:8000
