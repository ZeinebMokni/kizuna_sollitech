# Copy this file to backend/.env and fill in your Copernicus Data Space OAuth client.
# Create it at https://shapps.dataspace.copernicus.eu/dashboard/ -> User settings -> OAuth clients.
# Never commit or share the real .env file.
DATABASE_URL=postgresql+psycopg2://qatra:qatra@localhost:5433/qatra
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
